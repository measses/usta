# usta settings for Grok Bot's cloud computer. No secrets in this file.
# Copy to $USTA_ROOT/usta.env (default /workspace/usta/usta.env) and edit.

# Where usta keeps its kit, repos, logs and Claude config.
USTA_ROOT=/workspace/usta

# Optional private repo that holds your exported bundle (owner/name),
# and the folder inside it. Leave empty to run without a bundle.
USTA_BUNDLE_REPO=
USTA_BUNDLE_PATH=bundle

# Repos Claude Code may work on, one owner/name per line.
USTA_REPOS_FILE=/workspace/usta/repos.txt

# Commit identity used on the cloud computer.
USTA_GIT_NAME="Your Name (usta)"
USTA_GIT_EMAIL=you@users.noreply.github.com

# Skip runs when the cloud computer's egress country is one of these.
USTA_BLOCKED_COUNTRIES="CN HK MO RU BY IR KP SY CU"

# Branches usta-push refuses to push to.
USTA_PROTECTED_BRANCHES="main master production prod"
